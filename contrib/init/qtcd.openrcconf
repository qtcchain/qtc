# /etc/conf.d/qtcd: config file for /etc/init.d/qtcd

# Config file location
#QTCD_CONFIGFILE="/etc/qtc/qtc.conf"

# What directory to write pidfile to?  (created and owned by $QTCD_USER)
#QTCD_PIDDIR="/run/qtcd"

# What filename to give the pidfile
#QTCD_PIDFILE="${QTCD_PIDDIR}/${SVCNAME}.pid"

# Where to write qtcd data (be mindful that the blockchain is large)
#QTCD_DATADIR="/var/lib/qtcd"

# Location to write debug log
#QTCD_LOGDIR="/var/log/qtcd"

# User and group to own qtcd process
#QTCD_USER="qtc"
#QTCD_GROUP="qtc"

# Path to qtcd executable
#QTCD_BIN="/usr/bin/qtcd"

# Nice value to run qtcd under
#QTCD_NICE=0

# Additional options (avoid -conf and -datadir, use flags above)
#QTCD_OPTS=""

# The timeout in seconds OpenRC will wait for qtcd to terminate
# after a SIGTERM has been raised.
# Note that this will be mapped as argument to start-stop-daemon's
# '--retry' option, which means you can specify a retry schedule
# here. For more information see man 8 start-stop-daemon.
QTCD_SIGTERM_TIMEOUT=600
